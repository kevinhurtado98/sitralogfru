generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  nombres        String
  apellidos      String
  email          String   @unique
  password       String
  rol            Rol      @default(ASISTENTE)
  activo         Boolean  @default(true)
  notificaciones Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facturasCreadas           Factura[]       @relation("FacturaCreadaPor")
  requerimientosCrea        Requerimiento[] @relation("RequerimientoCreadoPor")
  requerimientosResponsable Requerimiento[] @relation("RequerimientoResponsable")
  requerimientosAtiende     Requerimiento[] @relation("RequerimientoAtendidoPor")
  auditLogs                 AuditLog[]

  // NextAuth
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CONFIGURACIÓN ───────────────────────────────────────────────────────────

model Area {
  id        String   @id @default(cuid())
  nombre    String   @unique
  color     String
  tc        String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsables Responsable[]

  @@map("areas")
}

model Responsable {
  id        String   @id @default(cuid())
  nombres   String
  apellidos String
  correo    String   @unique
  areaId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area Area @relation(fields: [areaId], references: [id])

  @@map("responsables")
}

// ─── COMPROBANTES ────────────────────────────────────────────────────────────

model Factura {
  id                    String        @id @default(cuid())
  proveedor             String
  rucProveedor          String?
  serie                 String
  numero                String
  fechaEmision          DateTime
  fechaVencimiento      DateTime
  moneda                Moneda        @default(SOLES)
  tipo                  TipoFactura
  monto                 Decimal       @db.Decimal(12, 2)
  retencion             Decimal       @default(0) @db.Decimal(12, 2)
  detraccion            Decimal       @default(0) @db.Decimal(12, 2)
  montoNeto             Decimal       @db.Decimal(12, 2)
  estado                EstadoFactura @default(PENDIENTE)
  formaPago             FormaPago?
  ordenCompra           String?
  fechaRegistroContable DateTime?
  registradoContable    Boolean       @default(false)
  semanaPago            Int?
  viernesPago           DateTime?
  notas                 String?       @db.Text
  xmlUrl                String?
  creadoPorId           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  creadoPor    User          @relation("FacturaCreadaPor", fields: [creadoPorId], references: [id])
  notasCredito NotaCredito[]
  notasDebito  NotaDebito[]

  @@unique([serie, numero])
  @@map("facturas")
}

model NotaCredito {
  id          String   @id @default(cuid())
  facturaId   String
  serie       String
  numero      String
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String?  @db.Text
  fecha       DateTime
  createdAt   DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("notas_credito")
}

model NotaDebito {
  id          String   @id @default(cuid())
  facturaId   String
  serie       String
  numero      String
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String?  @db.Text
  fecha       DateTime
  createdAt   DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("notas_debito")
}

// ─── REQUERIMIENTOS ──────────────────────────────────────────────────────────

model Requerimiento {
  id             String              @id @default(cuid())
  fechaSolicitud DateTime
  area           String
  prioridad      Prioridad
  tipo           TipoRequerimiento
  descripcion    String              @db.VarChar(1000)
  estado         EstadoRequerimiento @default(PENDIENTE)
  diasRetraso    Int                 @default(0)
  responsableId  String
  creadoPorId    String
  atendidoPorId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  responsable User  @relation("RequerimientoResponsable", fields: [responsableId], references: [id])
  creadoPor   User  @relation("RequerimientoCreadoPor", fields: [creadoPorId], references: [id])
  atendidoPor User? @relation("RequerimientoAtendidoPor", fields: [atendidoPorId], references: [id])


  @@map("requerimientos")
}

// ─── AUDITORÍA ───────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(cuid())
  userId          String
  modulo          Modulo
  accion          String
  entidadId       String
  datosAnteriores Json?
  datosNuevos     Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  ASISTENTE
}

enum Moneda {
  SOLES
  DOLARES
  EUROS
}

enum TipoFactura {
  COMPRA
  SERVICIO
}

enum EstadoFactura {
  POR_VENCER
  PENDIENTE
  PAGADA
  VENCIDA
}

enum FormaPago {
  CREDITO
  FACTORING
  FACTURA_NEGOCIABLE
  LETRA
}

enum Prioridad {
  ALTA
  MEDIA
}

enum TipoRequerimiento {
  COMPRA
  SERVICIO
}

enum EstadoRequerimiento {
  ATENDIDO_TOTAL
  ATENDIDO_PARCIAL
  PENDIENTE
  NO_ATENDIDO
}

enum Modulo {
  COMPROBANTES
  REQUERIMIENTOS
  USUARIOS
  AUTH
}
