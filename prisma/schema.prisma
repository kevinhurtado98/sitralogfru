generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.NVarChar(50)
  descripcion String?  @db.NVarChar(200)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios User[]

  @@map("Roles")
}

model User {
  id             Int      @id @default(autoincrement())
  nombres        String   @db.NVarChar(100)
  apellidos      String   @db.NVarChar(100)
  email          String   @unique @db.NVarChar(200)
  password       String   @db.NVarChar(200)
  rolId          Int
  activo         Boolean  @default(true)
  notificaciones Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rol                   Rol             @relation(fields: [rolId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  facturasCreadas       Factura[]       @relation("FacturaCreadaPor")
  requerimientosCrea    Requerimiento[] @relation("RequerimientoCreadoPor")
  requerimientosAtiende Requerimiento[] @relation("RequerimientoAtendidoPor")
  auditLogs             AuditLog[]

  @@map("Usuarios")
}

// ─── CONFIGURACIÓN ───────────────────────────────────────────────────────────

model Area {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.NVarChar(100)
  color     String   @db.NVarChar(10)
  tc        String   @db.NVarChar(10)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsables   Responsable[]
  requerimientos Requerimiento[]

  @@map("Areas")
}

model Responsable {
  id        Int      @id @default(autoincrement())
  nombres   String   @db.NVarChar(100)
  apellidos String   @db.NVarChar(100)
  correo    String   @unique @db.NVarChar(200)
  areaId    Int
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area           Area            @relation(fields: [areaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  requerimientos Requerimiento[]

  @@map("Responsables")
}

// ─── COMPROBANTES ────────────────────────────────────────────────────────────

model Factura {
  id                    Int      @id @default(autoincrement())
  proveedor             String   @db.NVarChar(200)
  rucProveedor          String?  @db.NVarChar(20)
  serie                 String   @db.NVarChar(10)
  numero                String   @db.NVarChar(20)
  fechaEmision          DateTime
  fechaVencimiento      DateTime
  moneda                String   @default("SOLES") @db.NVarChar(10)
  tipo                  String   @db.NVarChar(20)
  monto                 Decimal  @db.Decimal(12, 2)
  retencion             Decimal  @default(0) @db.Decimal(12, 2)
  detraccion            Decimal  @default(0) @db.Decimal(12, 2)
  montoNeto             Decimal  @db.Decimal(12, 2)
  estado                String   @default("PENDIENTE") @db.NVarChar(20)
  formaPago             String?  @db.NVarChar(25)
  ordenCompra           String?  @db.NVarChar(50)
  fechaRegistroContable DateTime?
  registradoContable    Boolean  @default(false)
  semanaPago            Int?
  viernesPago           DateTime?
  notas                 String?  @db.NVarChar(Max)
  xmlUrl                String?  @db.NVarChar(500)
  creadoPorId           Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  creadoPor    User          @relation("FacturaCreadaPor", fields: [creadoPorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notasCredito NotaCredito[]
  notasDebito  NotaDebito[]

  @@unique([serie, numero])
  @@map("Facturas")
}

model NotaCredito {
  id          Int      @id @default(autoincrement())
  facturaId   Int
  serie       String   @db.NVarChar(10)
  numero      String   @db.NVarChar(20)
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String?  @db.NVarChar(Max)
  fecha       DateTime
  createdAt   DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("NotasCredito")
}

model NotaDebito {
  id          Int      @id @default(autoincrement())
  facturaId   Int
  serie       String   @db.NVarChar(10)
  numero      String   @db.NVarChar(20)
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String?  @db.NVarChar(Max)
  fecha       DateTime
  createdAt   DateTime @default(now())

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("NotasDebito")
}

// ─── REQUERIMIENTOS ──────────────────────────────────────────────────────────

model Requerimiento {
  id                    Int      @id @default(autoincrement())
  fechaSolicitud        DateTime
  areaId                Int
  responsableId         Int
  prioridad             String   @default("ALTA") @db.NVarChar(10)
  tipo                  String   @db.NVarChar(15)
  descripcion           String   @db.NVarChar(1000)
  estado                String   @default("PENDIENTE") @db.NVarChar(25)
  diasRetraso           Int      @default(0)
  fechaEstimadaAtencion DateTime?
  creadoPorId           Int
  atendidoPorId         Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  area        Area        @relation(fields: [areaId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  responsable Responsable @relation(fields: [responsableId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creadoPor   User        @relation("RequerimientoCreadoPor", fields: [creadoPorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  atendidoPor User?       @relation("RequerimientoAtendidoPor", fields: [atendidoPorId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@map("Requerimientos")
}

// ─── AUDITORÍA ───────────────────────────────────────────────────────────────

model AuditLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  modulo          String   @db.NVarChar(30)
  accion          String   @db.NVarChar(100)
  entidadId       String   @db.NVarChar(50)
  datosAnteriores String?  @db.NVarChar(Max)
  datosNuevos     String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@map("Auditoria")
}

